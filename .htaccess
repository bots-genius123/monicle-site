# Oude Elementor-URL's (tot nov 2026) -> nieuwe pagina's. Dienst-, werkwijze- en over-ons-pagina's
# volgen nog; zodra die er zijn, de doelen hieronder bijwerken.
RedirectMatch 301 ^/(en/)?contact-2/?$ /contact/
RedirectMatch 301 ^/(en/)?(about-us-2|seo-service-detail-page|way-of-working|client-portfolio|why-seo|seo-audit)(/.*)?$ /
RedirectMatch 301 ^/(en/)?blog(/.*)?$ /
RedirectMatch 301 ^/en(/.*)?$ /

Options -Indexes

# Cache: HTML altijd opnieuw controleren (ETag, dus goedkoop), zodat een nieuwe versie direct zichtbaar is.
# Zonder deze regel gokte de browser zelf en hield hij de oude site tot ~2 weken vast.
# css/js/beelden: Hostinger cachet die 7 dagen; css/js krijgen daarom een ?v=<hash> in de HTML.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
